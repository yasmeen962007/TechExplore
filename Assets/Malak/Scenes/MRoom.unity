  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 20
  indentLevel: 1
  storyText: 'Yes, Robo will be with you in your world forever.

    But first, you
    have to go through this portal to complete your journey. I''ll go, and with success.'
  description: 
  character: {fileID: 1831628743}
  portrait: {fileID: 21300000, guid: e0e84afaf02a98f429d9b8fa692c37af, type: 3}
