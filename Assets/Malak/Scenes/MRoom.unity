  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 11
  indentLevel: 1
  storyText: "Good... I\u2019ll open another gate. It will take you to a place where
    you can find a computer. But be careful\u2026 if you don\u2019t bring it back\u2026
    you can\u2019t return to your world."
  description: 
  character: {fileID: 1831628743}
