  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 14
  indentLevel: 1
  storyText: "You\u2019re a hero! Because of that, I will give you a big reward!
    I will bring Robo to live with you forever! He will be your friend and help you
    with everything."
  description: 
  character: {fileID: 1831628743}
  portrait: {fileID: 21300000, guid: e0e84afaf02a98f429d9b8fa692c37af, type: 3}
