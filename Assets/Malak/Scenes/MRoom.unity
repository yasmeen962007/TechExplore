  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 13
  indentLevel: 1
  storyText: "Yes. The gate won\u2019t open again unless you come back with the computer.
    Understand this before you go."
  description: 
  character: {fileID: 1831628743}
  portrait: {fileID: 21300000, guid: e0e84afaf02a98f429d9b8fa692c37af, type: 3}
  voiceOverClip: {fileID: 8300000, guid: c10bd316d81105a43b353eb2e56224e6, type: 3}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
