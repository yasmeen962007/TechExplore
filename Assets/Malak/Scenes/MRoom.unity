  m_EditorClassIdentifier: 
  itemId: 21
  indentLevel: 1
  storyText: 'I''m ready.

    Thank you. I''ll go now and see Robo.'
  description: 
  character: {fileID: 1600960999}
  portrait: {fileID: 21300000, guid: da0fbc0540cb6924090aa2d0dbd2484e, type: 3}
